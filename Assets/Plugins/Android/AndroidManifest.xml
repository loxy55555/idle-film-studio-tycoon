<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access — required by AdMob, Firebase, and Unity IAP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FASE 17C/17I — Required by Google Play Console for in-app products -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <application>
        <!-- FASE 18 — AdMob App ID (must match Assets/Resources/AdMobConfig.json androidAppId) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7891351296222703~3411176678" />
        <!-- FASE 17I — Unity 6 GameActivity entry point (Player Settings: androidApplicationEntry = GameActivity) -->
        <activity android:name="com.unity3d.player.UnityPlayerGameActivity"
                  android:theme="@style/BaseUnityGameActivityTheme"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.app.lib_name" android:value="game" />
        </activity>
    </application>
</manifest>
